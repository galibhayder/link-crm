# Copy to .env and fill in real values.
# The API refuses to boot if any required variable is missing or malformed.

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser; CI greps the web bundle for this.
SUPABASE_SERVICE_ROLE_KEY=""
# HMAC secret for /internal/jobs/*. Minimum 32 characters.
JOB_HMAC_SECRET=""
# Explicit allowlist, comma separated. No wildcards.
CORS_ORIGINS="http://localhost:5173"
PORT=3000
LOG_LEVEL="info"
