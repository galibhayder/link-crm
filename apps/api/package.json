{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "// test": "NODE_ENV is pinned to `test` here, not inherited. A test run must not depend on whatever NODE_ENV happens to be set in the developer's shell — importing config/env.ts under production with development defaults aborts the whole runner instead of failing one test.",
    "test": "cross-env NODE_ENV=test vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "papaparse": "^5.7.1",
    "pdfmake": "^0.3.15",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
