# Frontend environment. Copy to apps/web/.env
#
# WARNING: Vite inlines every VITE_* variable into the browser bundle, so
# anything here is PUBLIC. Never add a service-role key or any server secret.

# Leave empty in development: the Vite proxy forwards /api to the local API, so
# the browser stays on one origin and there is no CORS to configure.
# Set this only for a split deployment (e.g. static site + API on a subdomain).
VITE_API_URL=""

VITE_SUPABASE_URL="http://127.0.0.1:54321"

# The anon key is designed to be public. Row Level Security decides what it can
# read. Paste the anon key from `pnpm exec supabase status`.
VITE_SUPABASE_ANON_KEY=""

# Build-time default only. The Admin panel overrides this at runtime from
# `organizations.name`, so renaming the business never requires a rebuild.
VITE_APP_NAME="Trivero Marketing"
