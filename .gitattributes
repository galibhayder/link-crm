# Normalise line endings so a Windows checkout and a Linux CI runner agree.
# Without this, every file touched on one and committed from the other shows as a
# whole-file diff, which buries the actual change.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe misreads them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.xlsx binary

# Lockfile is generated; keep it out of diffs in the review view but still tracked.
pnpm-lock.yaml linguist-generated=true
