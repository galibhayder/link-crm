# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
# The Hostinger deployment artifact. It contains node_modules and a copy of the
# compiled app — hundreds of MB, regenerated by `pnpm build:hostinger`, and never
# something to commit.
dist-hostinger/
.turbo/
*.tsbuildinfo
.vite/

# Database dumps contain full client PII and financial history. Never commit them.
backups/
*.dump
*.dump.gpg
*.sql.gz

# Test & coverage
coverage/
*.lcov
playwright-report/
test-results/
shots/

# Local env files — NEVER commit these. Only .env.example is tracked.
.env
.env.local
.env.development
.env.production
.env.*.local
!.env.example

# Supabase
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/functions/.env

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Assistant/tooling state. `.commandcode/` holds personal editor permissions and
# learned preferences — it is not project code and has no place in a public repo.
.commandcode/

# Playwright/Puppeteer output and one-off screenshot runs
shots*/

# Secrets and credentials that must never be committed
*.pem
*.key
*.p12
*.pfx
!public/*.svg
